{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Credits Tracker (Rust)",
  "identifier": "dev.jm-parent.credits-tracker-rust",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "npx vite --config vite.renderer.config.ts --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx vite build --config vite.renderer.config.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Credits Dashboard",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCNkQ3NkRBODgyMjI1MzUKUldRMUpTS0kyblp0aXl1c1NFQ1pESGU4ZnpSYnJOMHhjUWdwVDM4T1JCSVNjYTZKczNJWFVta3cK",
      "endpoints": [
        "https://github.com/jm-parent/CreditsTracker/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico"],
    "publisher": "jm-parent",
    "shortDescription": "Credits Dashboard for GitHub Copilot CLI",
    "longDescription": "Local dashboard for GitHub Copilot CLI credit consumption.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
